## ⏱️ Passo 3: Upload Seguro com Checksum e Metadados (15 min)

Não basta apenas "jogar" o arquivo no bucket. Precisamos de integridade (checksum) e rastreabilidade (metadados).

Adicione ao `swifttrack_storage.py`:
```python
import hashlib
import uuid
from datetime import datetime, timezone
import base64

def build_key(delivery_id: str, ext: str = "jpg") -> str:
    """Aplica a convenção de chaves definida no Lab 1."""
    now = datetime.now(timezone.utc)
    return f"pod/{now:%Y}/{now:%m}/{now:%d}/{delivery_id}/{uuid.uuid4()}.{ext}"

def upload_proof(file_path: str, delivery_id: str, driver_id: str) -> dict:
    s3 = get_s3_client()
    
    # 1. Ler e calcular hash SHA-256
    with open(file_path, "rb") as f:
        file_bytes = f.read()
    
    sha256_hash = hashlib.sha256(file_bytes).hexdigest()
    # O S3/MinIO espera o checksum em Base64 para a header ChecksumSHA256
    checksum_b64 = base64.b64encode(bytes.fromhex(sha256_hash)).decode('utf-8')
    
    key = build_key(delivery_id)
    
    # 2. Upload com metadados e controle de cache
    response = s3.put_object(
        Bucket=BUCKET_POD,
        Key=key,
        Body=file_bytes,
        ContentType="image/jpeg",
        ChecksumSHA256=checksum_b64, # Validação de integridade nativa do S3
        CacheControl="private, max-age=0, no-store", # Nunca cachear comprovante em CDN pública
        Metadata={
            "delivery-id": delivery_id,
            "driver-id": driver_id,
            "captured-at": datetime.now(timezone.utc).isoformat()
        }
    )
    
    return {
        "bucket": BUCKET_POD,
        "key": key,
        "sha256": sha256_hash,
        "size_bytes": len(file_bytes),
        "version_id": response.get("VersionId") # Só existe porque ativamos versionamento no Lab 1!
    }

# --- TESTE RÁPIDO ---
if __name__ == "__main__":
    resultado = upload_proof("testes/comprovante_exemplo.jpg", "DEL-998877", "DRV-102")
    print("✅ Upload realizado com sucesso!")
    print(f"Chave: {resultado['key']}")
    print(f"Version ID: {resultado['version_id']}")
```
Execute: `python swifttrack_storage.py`

